BIN=rdp2tcp.exe
CC=x86_64-w64-mingw32-gcc
CFLAGS=-Wall -g \
		 -D_WIN32_WINNT=0x0600 \
		 -I../common

# Vista+ (0x0600) rather than the server's XP-era 0x0501: the client calls
# inet_ntop(), which ws2tcpip.h only declares from Vista onwards. The client
# runs on the operator's own 64-bit desktop, so that floor costs nothing.

# -D_WIN32_WINNT=0x0600 -DDEBUG

LDFLAGS=-lws2_32
OBJS=	../common/iobuf.o \
	../common/print.o \
	../common/msgparser.o \
	../common/nethelper.o \
	../common/netaddr.o \
	main.o netsock.o tunnel.o channel.o w32chan.o \
	commands.o controller.o socks5.o

# clean first: the POSIX and mingw builds share .o names in this directory,
# so a stale object from the other toolchain would otherwise be linked in
all: clean clean_common $(BIN)

clean_common:
	$(MAKE) -C ../common clean

$(BIN): $(OBJS)
	$(CC) -o $@ $(OBJS) $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -o $@ -c $<

clean:
	rm -f $(OBJS) $(BIN)
